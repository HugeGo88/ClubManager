{
  "name": "clubmanager",
  "productName": "ClubManager",
  "version": "0.1.13",
  "private": true,
  "description": "A modular desktop app for managing a club.",
  "author": "ClubManager",
  "homepage": "https://github.com/HugeGo88/ClubManager",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "src/main/main.js",
  "scripts": {
    "build:editor": "esbuild src/renderer/markdown-editor.js --bundle --platform=browser --format=iife --outfile=src/renderer/generated/markdown-editor.js",
    "build:manual": "node scripts/build-manual.cjs",
    "build:assets": "npm run build:editor && npm run build:manual",
    "prestart": "npm run build:assets",
    "start": "electron .",
    "pretest": "node scripts/check-node-version.cjs",
    "test": "node --test",
    "pretest:electron": "node scripts/check-node-version.cjs && npm run build:assets",
    "check:node": "node scripts/check-node-version.cjs",
    "test:electron": "electron scripts/electron-smoke.cjs",
    "predist:mac": "npm run build:assets",
    "dist:mac": "electron-builder --mac dmg --arm64",
    "predist:win": "npm run build:assets",
    "dist:win": "electron-builder --win nsis --x64",
    "predist:linux": "npm run build:assets",
    "dist:linux": "electron-builder --linux deb --x64"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.39.0",
    "@lezer/css": "^1.3.9",
    "@material-design-icons/font": "^0.14.15",
    "electron-updater": "^6.8.11",
    "ical.js": "^2.2.1",
    "marked": "^12.0.2",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "app.clubmanager.desktop",
    "productName": "ClubManager",
    "artifactName": "ClubManager-${version}-${os}-${arch}.${ext}",
    "icon": "build/icon.png",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "deb",
      "category": "Office"
    },
    "deb": {
      "maintainer": "ClubManager"
    },
    "publish": {
      "provider": "github",
      "owner": "HugeGo88",
      "repo": "ClubManager"
    }
  }
}
