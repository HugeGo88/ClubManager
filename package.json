{
  "name": "clubmanager",
  "productName": "ClubManager",
  "version": "0.1.0",
  "private": true,
  "description": "A modular desktop app for managing a club.",
  "author": "ClubManager",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:electron": "electron scripts/electron-smoke.cjs",
    "dist:mac": "electron-builder --mac dmg --arm64",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "marked": "^12.0.2",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.clubmanager.desktop",
    "productName": "ClubManager",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": "nsis"
    }
  }
}
